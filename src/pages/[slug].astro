---
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CiteBox from '../components/CiteBox.astro';
import { visiblePages, formatDate, isoDate } from '../lib/content';

export async function getStaticPaths() {
  return (await visiblePages()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const isDraft = d.status === 'draft';
---
<Layout title={d.title} description={d.standfirst} section={entry.id === 'about' ? 'about' : undefined} noindex={isDraft} og={`page-${entry.id}`} published={!isDraft}>
  <div class="wrap wrap--page">
    {(isDraft || d.sample) && (
      <p class="banner" role="note">
        <b>Draft — not fact-checked</b>
        {d.sample && <span>Placeholder page: this template has no real text yet. It is not part of the book.</span>}
      </p>
    )}
    <header class="page-head">
      <h1>{d.title}</h1>
      <p class="page-head__stand">{d.standfirst}</p>
      <div class="page-head__meta">
        {d.first_published && <span>First published <time datetime={isoDate(d.first_published)}>{formatDate(d.first_published)}</time></span>}
        {d.last_revised && <span>Last revised <time datetime={isoDate(d.last_revised)}>{formatDate(d.last_revised)}</time></span>}
      </div>
    </header>
    <div class="eb-text"><Content /></div>
    <CiteBox title={d.title} lastRevised={d.last_revised} />
  </div>
</Layout>
