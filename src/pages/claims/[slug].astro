---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ClaimResponse from '../../components/ClaimResponse.astro';
import { visibleClaims, formatDate, isoDate } from '../../lib/content';

export async function getStaticPaths() {
  return (await visibleClaims()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const all = await visibleClaims();
const position = all.findIndex((c) => c.id === entry.id) + 1;
const isDraft = d.status === 'draft';
---
<Layout title={d.title} description={d.short_answer.slice(0, 200)} section="claims" noindex={isDraft}>
  <div class="wrap wrap--claim">
    <div class="claim-meta">
      <a class="back" href="/claims/">← Claims and responses</a>
      <span class="eyebrow">
        Claim {position} of {all.length}
        {d.last_revised && <> · Last revised <time datetime={isoDate(d.last_revised)}>{formatDate(d.last_revised)}</time></>}
      </span>
    </div>
    {(isDraft || d.sample) && (
      <p class="banner" role="note">
        <b>Draft — not fact-checked</b>
        {d.sample && <span>Sample page: placeholder text used to test the claim template. It is not part of the book.</span>}
      </p>
    )}
    <ClaimResponse claim={d.claim} attribution={d.attribution} answer={d.short_answer} evidence={d.evidence} />
    <div class="eb-text"><Content /></div>
  </div>
</Layout>
